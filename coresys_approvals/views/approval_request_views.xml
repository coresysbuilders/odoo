<odoo>
    <record id="view_approval_request_list" model="ir.ui.view">
        <field name="name">coresys.approval.request.list</field>
        <field name="model">coresys.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests"
                  decoration-info="state == 'to_approve'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'">
                <field name="name"/>
                <field name="category_id"/>
                <field name="requester_id"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_approval_request_inbox_list" model="ir.ui.view">
        <field name="name">coresys.approval.request.inbox.list</field>
        <field name="model">coresys.approval.request</field>
        <field name="arch" type="xml">
            <list string="To Approve" decoration-info="state == 'to_approve'">
                <field name="name"/>
                <field name="category_id"/>
                <field name="requester_id"/>
                <field name="active_approver_user_ids" widget="many2many_tags"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_approval_request_form" model="ir.ui.view">
        <field name="name">coresys.approval.request.form</field>
        <field name="model">coresys.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'to_approve'"
                            groups="coresys_approvals.group_approval_approver"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state != 'to_approve'"
                            groups="coresys_approvals.group_approval_approver"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state != 'refused'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'to_approve')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="category_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="reference" readonly="state != 'draft'"/>
                        </group>
                        <group string="Details">
                            <field name="requester_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Refusal"
                           invisible="state not in ('to_approve', 'refused')">
                        <field name="refusal_reason" nolabel="1"
                               placeholder="Required to refuse"/>
                    </group>
                    <group string="Approval Levels">
                        <field name="line_ids" nolabel="1" readonly="1">
                            <list string="Approval Levels" decoration-info="is_active_line">
                                <field name="is_active_line" column_invisible="1"/>
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="approver_user_ids" widget="many2many_tags"/>
                                <field name="status"/>
                            </list>
                        </field>
                    </group>
                    <group string="Decision History"
                           invisible="not response_ids">
                        <field name="response_ids" nolabel="1" readonly="1">
                            <list string="Decision History">
                                <field name="decided_on"/>
                                <field name="user_id"/>
                                <field name="delegated_for" optional="show"/>
                                <field name="level_name"/>
                                <field name="action"/>
                                <field name="reason"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
