<odoo>
    <record id="action_approval_category" model="ir.actions.act_window">
        <field name="name">Approval Categories</field>
        <field name="res_model">coresys.approval.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approval categories yet
            </p>
            <p>
                An approval category defines what needs approval — the document it
                applies to, an optional condition, and the sequence of levels a
                request must pass through. Create your first category, choose the
                document type it targets, then add its approval levels.
            </p>
        </field>
    </record>

    <record id="action_approval_request_new" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">coresys.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first approval request
            </p>
            <p>
                Choose an approval category, optionally reference the record it
                concerns, then submit to route it through the category's levels.
            </p>
        </field>
    </record>

    <record id="action_approval_request_inbox" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">coresys.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_approval_request_inbox_list"/>
        <field name="domain">[('state', '=', 'to_approve'), ('active_approver_user_ids', 'in', [uid])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing awaits your approval
            </p>
            <p>
                Requests routed to you appear here while they wait for your
                decision. Approve or refuse one and it leaves this list.
            </p>
        </field>
    </record>

    <menuitem id="menu_coresys_approvals_root"
              name="Approvals"
              web_icon="coresys_approvals,static/description/icon.png"
              groups="group_approval_user"
              sequence="90"/>

    <menuitem id="menu_approval_request_inbox"
              name="To Approve"
              parent="menu_coresys_approvals_root"
              action="action_approval_request_inbox"
              groups="group_approval_user"
              sequence="5"/>

    <menuitem id="menu_approval_delegation"
              name="My Delegations"
              parent="menu_coresys_approvals_root"
              action="action_approval_delegation"
              groups="group_approval_user"
              sequence="7"/>

    <menuitem id="menu_approval_request_new"
              name="Requests"
              parent="menu_coresys_approvals_root"
              action="action_approval_request_new"
              groups="group_approval_user"
              sequence="10"/>

    <menuitem id="menu_coresys_approvals_config"
              name="Configuration"
              parent="menu_coresys_approvals_root"
              groups="group_approval_user"
              sequence="90"/>

    <menuitem id="menu_approval_category"
              name="Approval Categories"
              parent="menu_coresys_approvals_config"
              action="action_approval_category"
              groups="group_approval_user"
              sequence="10"/>
</odoo>
