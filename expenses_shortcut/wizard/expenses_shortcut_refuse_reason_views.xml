<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Refuse Expense dialog -->

    <!-- 1. The dialog form itself. -->
    <record id="expenses_shortcut_refuse_wizard_view_form" model="ir.ui.view">
        <field name="name">expenses.shortcut.refuse.wizard.form</field>
        <field name="model">expenses.shortcut.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Expense refuse reason">
                <field name="expense_ids" invisible="1"/>
                <group>
                    <field string="Reason" name="reason" class="w-100"/>
                </group>
                <footer>
                    <button string='Refuse' name="action_refuse" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancel" class="oe_link" special="cancel" data-hotkey="x"/>
                </footer>
           </form>
        </field>
    </record>

    <!-- 2. The act_window the expense-side Refuse action returns. -->
    <record id="expenses_shortcut_refuse_wizard_action" model="ir.actions.act_window">
        <field name="name">Refuse Expense</field>
        <field name="res_model">expenses.shortcut.refuse.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="expenses_shortcut_refuse_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'medium'}</field>
    </record>

</odoo>
