<?xml version="1.0" encoding="utf-8"?>
<!-- CoreSys Builders — https://coresysbuilders.com | License OPL-1 -->
<odoo>
    <data noupdate="1">

        <!-- Ranborne Equipment Co. capital-spend sign-off: any purchase order
             above 10,000 must clear the department manager and then the finance
             director before it can be confirmed. Approvers reuse the engine demo
             staff by their module-qualified external ids. -->

        <record id="demo_category_capex" model="coresys.approval.category">
            <field name="name">Capital Expenditure Approval</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain">[('amount_total', '>', 10000)]</field>
            <field name="allow_self_approval" eval="False"/>
        </record>

        <record id="demo_level_capex_manager" model="coresys.approval.level">
            <field name="name">Department Manager</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="demo_category_capex"/>
            <field name="approver_user_ids" eval="[(4, ref('coresys_approvals.demo_user_dept_manager'))]"/>
        </record>

        <record id="demo_level_capex_finance" model="coresys.approval.level">
            <field name="name">Finance Director</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="demo_category_capex"/>
            <field name="approver_user_ids" eval="[(4, ref('coresys_approvals.demo_user_finance_director'))]"/>
        </record>

        <!-- A believable supplier and two catalogue items priced so a single
             order trips the 10,000 threshold. -->

        <record id="demo_supplier_meridian" model="res.partner">
            <field name="name">Meridian Industrial Supply</field>
            <field name="is_company" eval="True"/>
            <field name="supplier_rank">1</field>
            <field name="email">sales@meridian-industrial.com</field>
            <field name="phone">+1 614 555 0142</field>
            <field name="street">4820 Distribution Parkway</field>
            <field name="city">Columbus</field>
            <field name="zip">43217</field>
        </record>

        <record id="demo_product_forklift" model="product.product">
            <field name="name">Counterbalance Forklift 2.5T</field>
            <field name="type">consu</field>
            <field name="list_price">18500.00</field>
            <field name="standard_price">15200.00</field>
            <field name="purchase_ok" eval="True"/>
        </record>

        <record id="demo_product_racking" model="product.product">
            <field name="name">Heavy-Duty Pallet Racking Bay</field>
            <field name="type">consu</field>
            <field name="list_price">1250.00</field>
            <field name="standard_price">980.00</field>
            <field name="purchase_ok" eval="True"/>
        </record>

        <record id="demo_po_capex" model="purchase.order">
            <field name="partner_id" ref="demo_supplier_meridian"/>
            <field name="order_line" eval="[
                (0, 0, {
                    'product_id': ref('demo_product_forklift'),
                    'name': 'Counterbalance Forklift 2.5T',
                    'product_qty': 1,
                    'product_uom': ref('uom.product_uom_unit'),
                    'price_unit': 18500.00,
                    'date_planned': '2026-08-01 08:00:00',
                }),
                (0, 0, {
                    'product_id': ref('demo_product_racking'),
                    'name': 'Heavy-Duty Pallet Racking Bay',
                    'product_qty': 6,
                    'product_uom': ref('uom.product_uom_unit'),
                    'price_unit': 1250.00,
                    'date_planned': '2026-08-01 08:00:00',
                }),
            ]"/>
        </record>

    </data>
</odoo>
