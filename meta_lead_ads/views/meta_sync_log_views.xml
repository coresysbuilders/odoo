<odoo>
  <record id="meta_sync_log_view_list" model="ir.ui.view">
    <field name="name">meta.sync.log.list</field>
    <field name="model">meta.sync.log</field>
    <field name="arch" type="xml">
      <list>
        <field name="create_date"/>
        <field name="meta_leadgen_id"/>
        <field name="status"/>
        <field name="trigger"/>
        <field name="match_key"/>
        <field name="retry_count"/>
        <field name="lead_id"/>
      </list>
    </field>
  </record>

  <record id="meta_sync_log_view_form" model="ir.ui.view">
    <field name="name">meta.sync.log.form</field>
    <field name="model">meta.sync.log</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!-- Other users can read logs but not write them, so hide a button
               that would only fail for them. action_retry does its own check. -->
          <button name="action_retry" string="Retry" type="object"
                  class="btn-primary" invisible="status != 'failed'"
                  groups="meta_lead_ads.group_meta_admin"/>
        </header>
        <sheet>
          <group>
            <field name="meta_leadgen_id" readonly="1"/>
            <field name="status" readonly="1"/>
            <field name="trigger" readonly="1"/>
            <field name="match_key" readonly="1"/>
            <field name="retry_count" readonly="1"/>
            <field name="lead_id" readonly="1"/>
            <field name="error_message" readonly="1"/>
          </group>
          <group string="Raw Payload (admin only)" groups="meta_lead_ads.group_meta_admin">
            <field name="raw_payload" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- "Retry Selected" in the list Action menu. Same action_retry as the form
       button; limited to Meta admins for the same reason. -->
  <record id="action_meta_sync_log_retry_server" model="ir.actions.server">
    <field name="name">Retry Selected</field>
    <field name="model_id" ref="model_meta_sync_log"/>
    <field name="binding_model_id" ref="model_meta_sync_log"/>
    <field name="binding_view_types">list</field>
    <field name="groups_id" eval="[Command.link(ref('meta_lead_ads.group_meta_admin'))]"/>
    <field name="state">code</field>
    <field name="code">action = records.action_retry()</field>
  </record>
</odoo>
