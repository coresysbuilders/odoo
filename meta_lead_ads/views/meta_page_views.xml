<odoo>
    <record id="meta_page_view_list" model="ir.ui.view">
        <field name="name">meta.page.list</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="page_id"/>
                <field name="account_id"/>
                <field name="form_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="meta_page_view_form" model="ir.ui.view">
        <field name="name">meta.page.form</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_forms"
                                class="oe_stat_button" icon="fa-list-alt">
                            <field name="form_count" widget="statinfo" string="Lead Forms"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="page_id"/>
                        <field name="account_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
