<odoo>
    <!--
        Leads Analytics Dashboard: a top-level "Meta Leads" app for Meta admins.
        get_dashboard_metrics checks the group again on the server, since menu
        groups only hide the entry.
    -->

    <!-- The tag must match the registry key in static/src/dashboard/dashboard.js. -->
    <record id="meta_dashboard_action" model="ir.actions.client">
        <field name="name">Meta Leads Dashboard</field>
        <field name="tag">meta_lead_ads.dashboard</field>
    </record>

    <!-- No parent plus a web_icon makes this show up as an app on the home
         screen. -->
    <menuitem id="menu_meta_leads_root"
              name="Meta Leads"
              web_icon="meta_lead_ads,static/description/icon.png"
              groups="meta_lead_ads.group_meta_admin"
              sequence="50"/>

    <menuitem id="menu_meta_leads_dashboard"
              name="Dashboard"
              parent="menu_meta_leads_root"
              action="meta_dashboard_action"
              groups="meta_lead_ads.group_meta_admin"
              sequence="10"/>
</odoo>
