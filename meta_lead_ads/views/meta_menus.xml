<odoo>
    <!-- The two CRM-config menuitems are removed in favour of the single Settings
         home. The act_window actions below are kept — the Settings hub buttons
         reuse them. The existing DB menu rows are unlinked on upgrade by the
         explicit ir.ui.menu delete records in views/meta_settings_menu.xml. -->
    <record id="meta_account_action" model="ir.actions.act_window">
        <field name="name">Meta Accounts</field>
        <field name="res_model">meta.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="meta_sync_log_action" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">meta.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
