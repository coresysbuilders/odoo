<odoo>
    <!--
        Settings entry points. res_config_settings_views.xml loads after this
        file because its buttons reference these actions with %(...)d.

        The 18.x branch deletes its old CRM menus here. This 19.0 module never
        had them, so there is nothing to delete.
    -->

    <!-- All field mappings across forms. Without it they are only reachable
         from each form's mapping tab. -->
    <record id="meta_field_mapping_action" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">meta.field.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Odoo 19 dropped target 'inline'; like core, leave target unset. The
         'module' context key must match <app name="..."> in
         res_config_settings_views.xml or the section won't render. -->
    <record id="meta_config_settings_action" model="ir.actions.act_window">
        <field name="name">Meta Lead Ads Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'meta_lead_ads'}</field>
    </record>

    <!-- Settings menu entry, Meta admins only. -->
    <menuitem id="menu_meta_config_settings"
              name="Meta Lead Ads"
              parent="base.menu_administration"
              action="meta_config_settings_action"
              groups="meta_lead_ads.group_meta_admin"
              sequence="50"/>

</odoo>
