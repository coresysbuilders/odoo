<odoo>
    <!--
        The Settings entry points for the single Settings home.

        This file loads after views/meta_menus.xml and
        wizard/meta_onboarding_views.xml. res_config_settings_views.xml (the <app>
        form) loads after this file so its %(...)d button references to
        meta_field_mapping_action and meta_config_settings_action resolve at
        view-parse time.

        NOTE: this is a fresh Odoo 19.0 listing, so the legacy 18.x
        <menuitem> ids (menu_meta_accounts / menu_meta_sync_log /
        menu_meta_connect) never exist here — the old upgrade-safe
        <delete model="ir.ui.menu"> records were dropped (on a fresh install they
        only logged "Skipping deletion for missing XML ID" warnings and did
        nothing). Those menuitems are already absent from the module XML, so they
        are never created in the first place.
    -->

    <!-- 1. Global entry point to the per-form meta.field.mapping model.
         Otherwise the model is only reachable via mapping_ids; this gives it a
         global Settings entry point (full CRUD, reusing the existing list/form).
         No model change — form_id stays required. -->
    <record id="meta_field_mapping_action" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">meta.field.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 2. The Settings act_window. Odoo 19 removed the 'inline' target value
         (valid: current/new/fullscreen/main); core's own settings action now
         omits target entirely and defaults to 'current', so we do the same. The
         context module key must equal the <app name="..."> in
         res_config_settings_views.xml, otherwise the section will not render. -->
    <record id="meta_config_settings_action" model="ir.actions.act_window">
        <field name="name">Meta Lead Ads Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'meta_lead_ads'}</field>
    </record>

    <!-- 3. Admin-gated Settings menuitem under the technical Settings root. -->
    <menuitem id="menu_meta_config_settings"
              name="Meta Lead Ads"
              parent="base.menu_administration"
              action="meta_config_settings_action"
              groups="meta_lead_ads.group_meta_admin"
              sequence="50"/>

</odoo>
