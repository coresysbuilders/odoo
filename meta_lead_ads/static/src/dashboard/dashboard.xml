<!--
    Leads Analytics Dashboard template. Loaded through web.assets_backend,
    not the manifest data list. Status pills always show a text label, not
    just a colour. Sync Log and System Health ignore the selected period, and
    the page says so.
-->
<templates xml:space="preserve">

    <t t-name="meta_lead_ads.MetaLeadsDashboard">
        <div class="o_meta_dashboard" role="main">

            <!-- Header: logo, title, period selector, refresh -->
            <div class="o_meta_dash_header">
                <div class="o_meta_dash_brand">
                    <img class="o_meta_dash_logo"
                         src="/meta_lead_ads/static/description/icon.png"
                         alt="Meta Leads"/>
                    <span class="o_meta_dash_title">Meta Leads Dashboard</span>
                </div>
                <div class="o_meta_dash_controls">
                    <label class="o_meta_dash_period_label" for="o_meta_period">Period</label>
                    <select id="o_meta_period"
                            class="o_meta_dash_period"
                            aria-label="Select reporting period"
                            t-att-disabled="this.state.loading ? 'disabled' : false"
                            t-on-change="this.onPeriodChange">
                        <option value="month" t-att-selected="this.state.periodMode === 'month'">This month</option>
                        <option value="quarter" t-att-selected="this.state.periodMode === 'quarter'">This quarter</option>
                        <option value="year" t-att-selected="this.state.periodMode === 'year'">This year</option>
                        <option value="custom" t-att-selected="this.state.periodMode === 'custom'">Custom range</option>
                    </select>
                    <t t-if="this.isCustom">
                        <label class="o_meta_dash_date_label" for="o_meta_from">From</label>
                        <input id="o_meta_from" type="date"
                               aria-label="Custom range start date"
                               t-att-disabled="this.state.loading ? 'disabled' : false"
                               t-on-change="this.onDateFromChange"/>
                        <label class="o_meta_dash_date_label" for="o_meta_to">To</label>
                        <input id="o_meta_to" type="date"
                               aria-label="Custom range end date"
                               t-att-disabled="this.state.loading ? 'disabled' : false"
                               t-on-change="this.onDateToChange"/>
                    </t>
                    <button class="btn o_meta_dash_refresh"
                            aria-label="Refresh data"
                            t-att-disabled="this.state.loading ? 'disabled' : false"
                            t-on-click="this.refresh">
                        <i class="oi" data-icon="refresh" role="img" aria-hidden="true"/>
                        <span>Refresh data</span>
                    </button>
                </div>
            </div>
            <div class="o_meta_dash_rule"/>

            <!-- Error state: generic text, no backend error details -->
            <t t-if="this.state.error">
                <div class="o_meta_dash_state o_meta_dash_error">
                    <h2>Couldn't load dashboard data</h2>
                    <p>Something went wrong fetching the figures. Refresh the page; if it persists, check the Sync Log and System Health card below.</p>
                </div>
            </t>

            <!-- Loading skeleton -->
            <t t-elif="this.state.loading and !this.state.data">
                <div class="o_meta_dash_state o_meta_dash_loading" aria-busy="true">
                    <div class="o_meta_skel o_meta_skel_kpis"/>
                    <div class="o_meta_skel o_meta_skel_chart"/>
                </div>
            </t>

            <!-- Loaded dashboard -->
            <t t-else="">

                <!-- KPI row (New / Synced / Failed) -->
                <div class="o_meta_dash_kpis">
                    <div class="o_meta_kpi">
                        <div class="o_meta_kpi_label">New leads</div>
                        <div class="o_meta_kpi_basis">By Meta submission date</div>
                        <div class="o_meta_kpi_value" t-out="this.state.data.kpis.new"/>
                        <t t-if="this.state.data.deltas.new !== null and this.state.data.deltas.new !== undefined">
                            <div t-att-class="'o_meta_kpi_delta ' + this.deltaClass(this.state.data.deltas.new)">
                                <i class="oi" t-att-data-icon="this.deltaIcon(this.state.data.deltas.new)" aria-hidden="true"/>
                                <span t-out="this.formatPercent(this.state.data.deltas.new)"/>
                            </div>
                        </t>
                    </div>
                    <div class="o_meta_kpi">
                        <div class="o_meta_kpi_label">Synced</div>
                        <div class="o_meta_kpi_basis">By date processed in Odoo</div>
                        <div class="o_meta_kpi_value" t-out="this.state.data.kpis.synced"/>
                        <t t-if="this.state.data.deltas.synced !== null and this.state.data.deltas.synced !== undefined">
                            <div t-att-class="'o_meta_kpi_delta ' + this.deltaClass(this.state.data.deltas.synced)">
                                <i class="oi" t-att-data-icon="this.deltaIcon(this.state.data.deltas.synced)" aria-hidden="true"/>
                                <span t-out="this.formatPercent(this.state.data.deltas.synced)"/>
                            </div>
                        </t>
                    </div>
                    <div class="o_meta_kpi">
                        <div class="o_meta_kpi_label">Failed</div>
                        <div class="o_meta_kpi_basis">Unresolved, by date processed in Odoo</div>
                        <div class="o_meta_kpi_value" t-out="this.state.data.kpis.failed"/>
                        <t t-if="this.state.data.deltas.failed !== null and this.state.data.deltas.failed !== undefined">
                            <div t-att-class="'o_meta_kpi_delta ' + this.deltaClass(this.state.data.deltas.failed)">
                                <i class="oi" t-att-data-icon="this.deltaIcon(this.state.data.deltas.failed)" aria-hidden="true"/>
                                <span t-out="this.formatPercent(this.state.data.deltas.failed)"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Overview row: line chart + conversion metrics -->
                <div class="o_meta_dash_row o_meta_dash_overview">
                    <div class="o_meta_card o_meta_card_chart">
                        <h2 class="o_meta_card_title">Meta Leads Dashboard</h2>
                        <t t-if="this.isEmptyWindow">
                            <div class="o_meta_dash_empty">
                                <t t-if="this.isFirstRun">
                                    <h3>No Meta leads yet</h3>
                                    <p>Once leads start arriving from your connected Meta forms, this dashboard will fill in automatically.</p>
                                </t>
                                <t t-else="">
                                    <h3>No Meta leads in this period</h3>
                                    <p>No Meta leads were submitted between
                                        <t t-out="this.state.data.window.from"/> and <t t-out="this.state.data.window.to"/>. Try a wider period, or check the Sync Log for ingestion errors.</p>
                                </t>
                            </div>
                        </t>
                        <div class="o_meta_chart_wrap o_meta_line_wrap" t-att-class="this.isEmptyWindow ? 'd-none' : ''">
                            <canvas t-ref="this.lineRef" aria-label="Leads over time line chart"/>
                        </div>
                    </div>
                    <div class="o_meta_card o_meta_card_conversion">
                        <h2 class="o_meta_card_title">Conversion</h2>
                        <div class="o_meta_conv_metric">
                            <span class="o_meta_conv_label">Converted from lead</span>
                            <span class="o_meta_conv_value">· <t t-out="this.formatRate(this.state.data.conversion.converted_rate)"/></span>
                        </div>
                        <div class="o_meta_kpi_basis mb-2"
                             t-if="this.state.data.conversion.converted_rate === null">No leads to convert in this period</div>
                        <div class="o_meta_kpi_basis mb-2">Created as opportunity · <t t-out="this.state.data.conversion.created_as_opportunity"/></div>
                        <div class="o_meta_conv_metric">
                            <span class="o_meta_conv_label">Won rate</span>
                            <span class="o_meta_conv_value">· <t t-out="this.formatRate(this.state.data.conversion.won_rate)"/></span>
                        </div>
                        <div class="o_meta_kpi_basis mb-2"
                             t-if="this.state.data.conversion.won_rate === null">No opportunities in this period</div>
                    </div>
                </div>

                <!-- Performance row: Top Campaigns donut + drill-down -->
                <div class="o_meta_dash_row o_meta_dash_performance">
                    <div class="o_meta_card o_meta_card_donut">
                        <h2 class="o_meta_card_title">Top Campaigns</h2>
                        <div class="o_meta_drill_toggle" role="group" aria-label="Drill-down level">
                            <button type="button"
                                    aria-label="Group by campaign"
                                    t-att-class="'o_meta_drill_btn ' + (this.state.drilldown === 'campaign' ? 'o_meta_drill_active' : '')"
                                    t-att-disabled="this.state.loading ? 'disabled' : false"
                                    t-on-click="() => this.setDrilldown('campaign')">By campaign</button>
                            <button type="button"
                                    aria-label="Show top ads"
                                    t-att-class="'o_meta_drill_btn ' + (this.state.drilldown === 'ads' ? 'o_meta_drill_active' : '')"
                                    t-att-disabled="this.state.loading ? 'disabled' : false"
                                    t-on-click="() => this.setDrilldown('ads')">Top ads</button>
                            <button type="button"
                                    aria-label="Show top ad sets"
                                    t-att-class="'o_meta_drill_btn ' + (this.state.drilldown === 'adsets' ? 'o_meta_drill_active' : '')"
                                    t-att-disabled="this.state.loading ? 'disabled' : false"
                                    t-on-click="() => this.setDrilldown('adsets')">Top ad sets</button>
                        </div>
                        <t t-if="!this.donutRows.length">
                            <div class="o_meta_dash_empty">
                                <h3>No Meta leads in this period</h3>
                                <p>No Meta leads were submitted between
                                    <t t-out="this.state.data.window.from"/> and <t t-out="this.state.data.window.to"/>. Try a wider period, or check the Sync Log for ingestion errors.</p>
                            </div>
                        </t>
                        <div class="o_meta_chart_wrap o_meta_donut_wrap" t-att-class="!this.donutRows.length ? 'd-none' : ''">
                            <canvas t-ref="this.donutRef" aria-label="Top campaigns donut chart"/>
                        </div>
                    </div>
                    <div class="o_meta_card o_meta_card_ranking">
                        <h2 class="o_meta_card_title">Ranked by lead volume — conversion shown per row</h2>
                        <table class="o_meta_rank_table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Leads</th>
                                    <th>Converted</th>
                                    <th>Won rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.drilldownRows" t-as="row" t-key="this.state.drilldown + '/' + row_index">
                                    <tr>
                                        <td t-out="row.name"/>
                                        <td t-out="row.count"/>
                                        <td t-out="this.formatRate(row.converted_rate)"/>
                                        <td t-out="this.formatRate(row.won_rate)"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p class="o_meta_rank_footnote">Campaigns with fewer than 10 leads are excluded from the conversion ranking. Campaigns, ad sets and ads are grouped by Meta ID and shown under their latest name. A dash means there was nothing to measure in that row: no leads to convert, or no opportunities to win.</p>
                    </div>
                </div>

                <!-- Operations row: Sync Log (Recent) + System Health -->
                <p class="o_meta_global_note" role="note">Sync Log (Recent) and System Health are global — they do not change with the selected period.</p>
                <div class="o_meta_dash_row o_meta_dash_ops">
                    <div class="o_meta_card o_meta_card_synclog">
                        <h2 class="o_meta_card_title">Sync Log (Recent)</h2>
                        <ul class="o_meta_synclog_list">
                            <t t-if="!this.state.data.sync_recent.length">
                                <li class="o_meta_synclog_empty">No sync activity yet.</li>
                            </t>
                            <t t-foreach="this.state.data.sync_recent" t-as="log" t-key="log_index">
                                <li class="o_meta_synclog_row">
                                    <span t-att-class="'o_meta_pill ' + this.statusPillClass(log.status)">
                                        <t t-out="this.statusLabel(log.status)"/>
                                    </span>
                                    <span class="o_meta_synclog_ref" t-out="this.shortRef(log.meta_leadgen_id)"/>
                                    <span class="o_meta_synclog_sep">·</span>
                                    <span class="o_meta_synclog_time" t-out="this.relativeTime(log.create_date)"/>
                                </li>
                            </t>
                        </ul>
                        <a href="#" class="o_meta_link_out"
                           aria-label="View full sync log"
                           t-on-click.prevent="this.openFullSyncLog">View Full Sync Log →</a>
                    </div>
                    <div class="o_meta_card o_meta_card_health">
                        <h2 class="o_meta_card_title">System Health</h2>
                        <div class="o_meta_health_signal">
                            <span class="o_meta_health_name">Webhook</span>
                            <span t-att-class="'o_meta_pill ' + this.statusPillClass(this.state.data.health.webhook.status)" t-out="this.state.data.health.webhook.label"/>
                            <span class="o_meta_health_caption" t-out="this.state.data.health.webhook.caption"/>
                        </div>
                        <div class="o_meta_health_signal">
                            <span class="o_meta_health_name">Queue drain</span>
                            <span t-att-class="'o_meta_pill ' + this.statusPillClass(this.state.data.health.drain.status)" t-out="this.state.data.health.drain.label"/>
                            <span class="o_meta_health_caption" t-out="this.state.data.health.drain.caption"/>
                        </div>
                        <div class="o_meta_health_signal">
                            <span class="o_meta_health_name">Backfill</span>
                            <span t-att-class="'o_meta_pill ' + this.statusPillClass(this.state.data.health.backfill.status)" t-out="this.state.data.health.backfill.label"/>
                            <span class="o_meta_health_caption" t-out="this.state.data.health.backfill.caption"/>
                        </div>
                        <div class="o_meta_health_signal">
                            <span class="o_meta_health_name">Token</span>
                            <span t-att-class="'o_meta_pill ' + this.statusPillClass(this.state.data.health.token.status)" t-out="this.state.data.health.token.label"/>
                            <span class="o_meta_health_caption" t-out="this.state.data.health.token.caption"/>
                        </div>
                        <!-- Neither grey state is a fault, so say what each one means. -->
                        <p class="o_meta_rank_footnote" t-if="this.state.data.health.webhook.status === 'quiet'">Quiet means Odoo hasn't processed a webhook lead in the last 24 hours. That is normal on a low-traffic form, but rejected calls from Meta (for example after an App Secret change) and a turned-off subscription look the same, so check the Webhooks page of your Meta app if you expect leads.</p>
                        <p class="o_meta_rank_footnote" t-if="this.state.data.health.webhook.status === 'no_activity'">No successful webhook lead is recorded yet. If you expect leads, check that the Page is subscribed and that the Webhook URL is reachable from the internet over HTTPS.</p>
                    </div>
                </div>

            </t>
        </div>
    </t>

</templates>
