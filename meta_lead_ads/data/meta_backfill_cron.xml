<odoo>
  <!-- noupdate so intervals and values an admin changes survive an upgrade. -->
  <data noupdate="1">
    <!-- Polls every active, sync-enabled form (one savepoint per form) and
         passes each lead to ingest_leadgen. Runs as the cron user, which can
         read the admin-only token. -->
    <record id="cron_meta_backfill" model="ir.cron">
      <field name="name">Meta: Backfill Leads (per-form sweep)</field>
      <field name="model_id" ref="model_meta_lead_form"/>
      <field name="state">code</field>
      <field name="code">model._cron_backfill()</field>
      <field name="interval_number">15</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>

    <!-- Daily check that each account's token still works. -->
    <record id="cron_meta_token_health" model="ir.cron">
      <field name="name">Meta: Token Health Check</field>
      <field name="model_id" ref="model_meta_account"/>
      <field name="state">code</field>
      <field name="code">model._cron_token_health()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>

    <!-- How many days back the backfill looks. Read by
         meta.lead.form._backfill_lookback_days(). -->
    <record id="meta_backfill_lookback_days" model="ir.config_parameter">
      <field name="key">meta_lead_ads.backfill_lookback_days</field>
      <field name="value">30</field>
    </record>

    <!-- Daily cleanup of meta.sync.log, which would otherwise keep growing
         (every webhook retry and backfill overlap logs a skipped row). Only
         success and skipped rows past the retention window are removed;
         failed and pending rows are kept. -->
    <record id="cron_meta_sync_log_vacuum" model="ir.cron">
      <field name="name">Meta: Vacuum Sync Logs</field>
      <field name="model_id" ref="model_meta_sync_log"/>
      <field name="state">code</field>
      <field name="code">model._cron_vacuum_logs()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>

    <!-- Sync log retention in days; 0 turns the cleanup off. Databases still
         on the old 90-day default are moved to 14 by the 18.0.11.0.0
         migration. -->
    <record id="meta_sync_log_retention_days" model="ir.config_parameter">
      <field name="key">meta_lead_ads.sync_log_retention_days</field>
      <field name="value">14</field>
    </record>

    <!-- Each backfill re-reads the last N seconds, because Meta can make a
         lead visible a little after its created_time. The re-read leads are
         skipped by the unique leadgen_id, so this can't create duplicates. -->
    <record id="meta_backfill_overlap_seconds" model="ir.config_parameter">
      <field name="key">meta_lead_ads.backfill_overlap_seconds</field>
      <field name="value">60</field>
    </record>
  </data>
</odoo>
