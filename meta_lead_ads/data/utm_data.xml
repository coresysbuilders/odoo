<odoo>
  <data noupdate="1">
    <!-- Facebook and Instagram are not created here: Odoo 20 ships
         utm.utm_source_facebook and utm.utm_source_instagram, and a second
         one would be renamed "Instagram [2]". A database upgraded from an
         older version keeps the module's own Instagram source, which ingest
         goes on using. Odoo has no "Paid Social" medium, so we add that. -->
    <record id="utm_medium_paid_social" model="utm.medium">
      <field name="name">Paid Social</field>
    </record>
  </data>
</odoo>
