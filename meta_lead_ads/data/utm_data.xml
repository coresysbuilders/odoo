<odoo>
  <data noupdate="1">
    <!-- Facebook is not created here: Odoo already has utm.utm_source_facebook,
         and a second one would be renamed "Facebook [2]". Odoo has no Instagram
         source or "Paid Social" medium, so we add those. -->
    <record id="utm_source_meta_instagram" model="utm.source">
      <field name="name">Instagram</field>
    </record>
    <record id="utm_medium_paid_social" model="utm.medium">
      <field name="name">Paid Social</field>
    </record>
  </data>
</odoo>
