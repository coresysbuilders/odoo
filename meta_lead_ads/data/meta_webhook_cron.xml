<odoo>
  <!-- noupdate="1": the interval is admin-tunable. An admin who widens or
       narrows the drain cadence keeps that edit across a module upgrade — Odoo
       only writes this record on first install, never on -u. -->
  <data noupdate="1">
    <!-- Deferred drain. The webhook controller ACKs fast and only inserts pending
         meta.webhook.event rows; this cron is what actually moves pending -> done
         by calling _cron_drain(), a thin wrapper over the ingest_leadgen service.
         The cron creates no crm.lead itself. -->
    <record id="cron_meta_webhook_drain" model="ir.cron">
      <field name="name">Meta: Drain Webhook Event Queue</field>
      <field name="model_id" ref="model_meta_webhook_event"/>
      <field name="state">code</field>
      <field name="code">model._cron_drain()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
