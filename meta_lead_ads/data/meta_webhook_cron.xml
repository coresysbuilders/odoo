<odoo>
  <!-- noupdate so an admin's interval change survives a module upgrade. -->
  <data noupdate="1">
    <!-- The webhook only stores events and answers Meta quickly. This cron
         processes the pending events through ingest_leadgen. -->
    <record id="cron_meta_webhook_drain" model="ir.cron">
      <field name="name">Meta: Drain Webhook Event Queue</field>
      <field name="model_id" ref="model_meta_webhook_event"/>
      <field name="state">code</field>
      <field name="code">model._cron_drain()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
